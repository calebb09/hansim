  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Student One\",\n  \"email\": \"student@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"STUDENT\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Creates a user in Firebase and the local database. Parsed as JSON by `express.json()`. Zod currently validates `fullName`, `email`, and `password`; `role` is used by the controller if supplied."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.idToken) pm.collectionVariables.set('firebaseToken', json.idToken);",
                  "if (json.user && json.user.id) pm.collectionVariables.set('userId', json.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@example.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Firebase email/password login. Parsed as JSON by `express.json()`. The test script stores `idToken` as `firebaseToken`; JWT-protected routes still need a valid app JWT in `jwtToken`."
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"PASTE_FIREBASE_REFRESH_TOKEN\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "description": "Refreshes Firebase tokens. Incoming request can be JSON via `express.json()` or URL-encoded via `bodyParser.urlencoded()`; this sample uses JSON."
          }
        },
        {
          "name": "Revoke User Tokens",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{firebaseToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/revoke/{{firebaseUid}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "revoke",
                "{{firebaseUid}}"
              ]
            },
            "description": "Firebase-protected route. Requires Firebase bearer token with role `ADMIN`. Route parameter is named `uid`; controller currently looks up `prisma.user.findUnique({ where: { id: uid } })`."
          }
        }
      ]
