              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"evt_test_webhook\",\n  \"object\": \"event\",\n  \"type\": \"checkout.session.completed\",\n  \"data\": {\n    \"object\": {\n      \"id\": \"cs_test_example\",\n      \"object\": \"checkout.session\",\n      \"amount_total\": 9999,\n      \"currency\": \"usd\",\n      \"metadata\": {\n        \"userId\": \"{{userId}}\",\n        \"courseId\": \"{{courseId}}\"\n      }\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/payment/webhook",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payment",
                "webhook"
              ]
            },
            "description": "Stripe webhook route. Parsed as raw `application/json` using `express.raw({ type: \"application/json\" })` for Stripe signature verification. A normal hand-written request will fail unless `Stripe-Signature` matches the exact raw body and `STRIPE_WEBHOOK_SECRET`."
          }
        }
